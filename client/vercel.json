{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://your-backend-api.onrender.com/api/:match*"
    },
    {
      "source": "/health",
      "destination": "https://your-backend-api.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
